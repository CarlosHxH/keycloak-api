MOCK_USER_SUB=123456
MOCK_USER_USERNAME=
MOCK_USER_EMAIL=admin@example.com
MOCK_USER_FIRST_NAME=Usuario
MOCK_USER_LAST_NAME=Mock

MOCK_ACCESS_TOKEN_EXPIRES_IN=1h
MOCK_REFRESH_TOKEN_EXPIRES_IN=30d

# Única obrigatória: URL pública do mock (vai no issuer dos tokens).
MOCK_KEYCLOAK_URL=http://localhost:9090

# Realm e client são dinâmicos (vêm da URL e do client_id de cada requisição).
# Estes são só os valores sugeridos no painel. Padrões: master / account.
MOCK_KEYCLOAK_REALM=SESP
MOCK_CLIENT_ID=srop-app

# Sistemas: todos os config/*.json + os cadastrados pelo painel; o sistema é escolhido
# pelo client_id do JSON. Este é o sistema usado quando o client não tem sistema próprio
# (vazio = união das roles de todos os sistemas).
MOCK_SISTEMA_CONFIG=config/srop.json
# Perfil (grupo dos JSON) usado para calcular as roles. Vazio ou * = todas as funcionalidades ativas.
MOCK_PERFIL=ADMINISTRADOR

# Usuário e senha exigidos na tela de login e no painel (padrão: admin / admin).
# Troque a senha quando o mock estiver acessível na rede.
MOCK_ADMIN_USUARIO=admin
MOCK_ADMIN_SENHA=admin

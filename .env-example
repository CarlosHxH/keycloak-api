MOCK_USER_SUB=123456
MOCK_USER_USERNAME=
MOCK_USER_EMAIL=admin@example.com
MOCK_USER_FIRST_NAME=Usuario
MOCK_USER_LAST_NAME=Mock

MOCK_ACCESS_TOKEN_EXPIRES_IN=1h
MOCK_REFRESH_TOKEN_EXPIRES_IN=30d

MOCK_KEYCLOAK_REALM=SESP
MOCK_KEYCLOAK_URL=http://localhost:9090
MOCK_CLIENT_ID=srop-app

# JSON do sistema que gera as roles (relativo à raiz). Padrão: config/config.json
MOCK_SISTEMA_CONFIG=config/srop.json
# Filtra as roles pelos grupos do JSON (srop.json: ADMINISTRADOR, ADM_ORGAO, OPERADOR).
# Vazio = todas as funcionalidades ativas (inclui as roles de RESTRICAO).
MOCK_PERFIL=ADMINISTRADOR

# Usuário e senha exigidos na tela de login e no painel (padrão: admin / admin).
# Troque a senha quando o mock estiver acessível na rede.
MOCK_ADMIN_USUARIO=admin
MOCK_ADMIN_SENHA=admin
